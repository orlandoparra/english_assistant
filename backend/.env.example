# Copia este archivo como ".env" y rellena los valores reales.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Base de datos. Por ahora SQLite (un archivo local).
# Cuando migres a PostgreSQL (Neon/Supabase), cambia esta línea por la URL que te den.
DATABASE_URL=sqlite:///./english_assistant.db

# Clave secreta para firmar los tokens JWT. Usa una cadena larga y aleatoria.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30
